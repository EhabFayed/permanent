    {
      "name": "Authentication",
      "description": "Endpoints for authenticating admin users.",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "user[name]", "value": "Admin User", "type": "text"},
                {"key": "user[email]", "value": "admin@example.com", "type": "text"},
                {"key": "user[password]", "value": "password", "type": "text"},
                {"key": "user[password_confirmation]", "value": "password", "type": "text"}
              ]
            },
            "url": {
              "raw": "http://localhost:3000/signup",
              "protocol": "http",
