                "value": "Bearer {{token}}",
                "type": "text",
                "description": "JWT Bearer token from the login endpoint"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["users", "1"]
            },
            "description": "Update the user's profile."
          }
        }
      ]
