{
  "info": {
    "name": "permanent",
    "description": "Postman collection for Milaknight project. Contains both Admin endpoints (requiring Authorization) and Public Website endpoints (with locale header and pagination).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Website (Public)",
      "description": "Publicly accessible endpoints that provide data for the frontend website. Supports `locale` header.",
      "item": [
        {
          "name": "Blogs Landing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "locale",
                "value": "en",
                "type": "text",
                "description": "Language code. 'en' for English or 'ar' for Arabic. This automatically shapes the JSON response to return keys without the _en or _ar suffix."
              }
            ],
            "url": {
              "raw": "http://localhost:3000/blogs_landing?page=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["blogs_landing"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Pagy pagination page number"
                }
              ]
            },
            "description": "Retrieves the paginated list of published blogs for the landing page."
          }
        },
        {
          "name": "Blog Show",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "locale",
                "value": "en",
                "type": "text",
                "description": "Language code. 'en' for English or 'ar' for Arabic. This automatically shapes the JSON response to return keys without the _en or _ar suffix."
              }
            ],
            "url": {
              "raw": "http://localhost:3000/blog_show?slug=sample-slug",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["blog_show"],
              "query": [
                {
                  "key": "slug",
                  "value": "sample-slug",
                  "description": "The slug of the blog (either slug or slug_ar)"
                }
              ]
            },
            "description": "Retrieves a single blog using its slug, including contents and faqs."
          }
        },
        {
          "name": "Products Website",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "locale",
                "value": "en",
                "type": "text",
                "description": "Language code. 'en' for English or 'ar' for Arabic. This automatically shapes the JSON response to return keys without the _en or _ar suffix."
              }
            ],
            "url": {
              "raw": "http://localhost:3000/products_website?page=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["products_website"],
