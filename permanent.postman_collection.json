          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "email", "value": "admin@example.com", "type": "text"},
                {"key": "password", "value": "password", "type": "text"}
              ]
            },
            "url": {
              "raw": "http://localhost:3000/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["login"]
            },
            "description": "Logs in an admin user and returns a JWT token."
